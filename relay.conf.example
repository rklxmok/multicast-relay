# relay.conf — multicast relay configuration
# Normally generated by: sudo mcast-relay-setup (guided)
# Copy to /opt/mcast-relay/relay.conf if configuring by hand.

# Local IP on the source-facing interface (facing the multicast sender,
# e.g. the Nyquist paging server VLAN).
IN_IF=172.18.207.253

# Local IP on the receiver-facing interface (facing the paging receivers).
OUT_IF=172.19.215.253

# The multicast sender's unicast IP. This is a static (S,G) key — if the
# sender's address changes, forwarding stops silently. Get a DHCP
# reservation or a static assignment for it. Use "any" for a wildcard
# (*,G) entry only if you accept the risk (any source can be forwarded).
SOURCE=172.18.192.210

# Multicast groups to relay: single, comma list, or hyphen range.
GROUPS=239.1.1.1-239.1.1.39

# Port policy. The MFC cache is port-agnostic — enforcement lives in the
# nftables forward chain that setup generates.
#   all  = relay every UDP port within the groups (recommended for paging)
#   list = relay only the ports in PORTS
PORT_POLICY=all
PORTS=5002,5003
